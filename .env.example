# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Defaults assume local execution (uv run cigars ...) hitting the port
# exposed by docker compose. Inside containers, Compose overrides
# POSTGRES_HOST=postgres / REDIS_HOST=redis automatically.
POSTGRES_USER=cigars
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=cigars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=dev

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console        # console | json

# ---------------------------------------------------------------------------
# S3-compatible object storage (media)
# Default points at the SeaweedFS sidecar on localhost; in Docker Compose
# the app service overrides S3_ENDPOINT_URL to http://seaweedfs:8333.
# Migration to AWS S3 / Cloudflare R2 / Backblaze B2 = change endpoint + keys.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=cigars-media
S3_ACCESS_KEY_ID=cigars-dev
S3_SECRET_ACCESS_KEY=cigars-dev-secret-change-me

# ---------------------------------------------------------------------------
# Media pipeline
# ---------------------------------------------------------------------------
MEDIA_MAX_BYTES=8388608        # 8 MiB cap per image
MEDIA_WEBP_QUALITY=85

# ---------------------------------------------------------------------------
# PISTE / DILA API (Légifrance)
# Create an account at https://piste.gouv.fr/ → application → client_credentials
# Required to activate the source `fr-legifrance-dila` (JSON API, no WAF).
# ---------------------------------------------------------------------------
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token
PISTE_API_BASE_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app
PISTE_SCOPE=openid

# ---------------------------------------------------------------------------
# ProtonVPN Free via gluetun (L2 sidecar) — custom WireGuard mode
# ---------------------------------------------------------------------------
# Proton Free does NOT support gluetun's native VPN_SERVICE_PROVIDER=protonvpn
# (paid tier required for the server-list API). Use the custom WireGuard route:
#
# 1. Go to https://account.protonvpn.com/downloads → WireGuard configuration
# 2. Create a new config (toggle "Bouncing" ON for free IP rotation)
# 3. Pick a "FREE" server (NL, US, JP, RO, PL)
# 4. Copy the [Interface]/[Peer] values into the variables below
# 5. Start the sidecar:  docker compose --profile vpn up -d gluetun
#
# PROTON_WG_PRIVATE_KEY=<Interface.PrivateKey from Proton config>
# PROTON_WG_PUBLIC_KEY=<Peer.PublicKey from Proton config>
# PROTON_WG_ENDPOINT_IP=<Peer.Endpoint IP (before the colon)>
# PROTON_WG_ENDPOINT_PORT=51820
# PROTON_WG_ADDRESSES=10.2.0.2/32
# PROTON_DNS=10.2.0.1

# ---------------------------------------------------------------------------
# Tor SOCKS5 fallback (L3) — no credentials needed
# ---------------------------------------------------------------------------
# Start with:  docker compose --profile tor up -d tor
